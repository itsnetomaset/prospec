# Safety net for hosts that serve the project root: nothing here is public except public/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^(config\.php|config\.example\.php|composer\.(json|lock)|phpunit\.xml\.dist)$">
    Require all denied
</FilesMatch>
